<?xml version="1.0" encoding="utf-8"?>
<!--
  Isola o restore da solution das fontes configuradas a nivel de maquina.

  O instalador do Visual Studio deixa em
  C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.Offline.config
  uma fonte "Microsoft Visual Studio Offline Packages" apontando para
  C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\, que nesta maquina nao
  existe, e o `dotnet restore`/msbuild da solution falhava com NU1301 antes de
  chegar a compilar qualquer coisa. Com <clear/> o restore passa a depender so do
  nuget.org, entao o build por linha de comando funciona igual ao da IDE.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
