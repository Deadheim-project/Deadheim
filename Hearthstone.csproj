    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- ServerSync compilado do fonte, nao a DLL de 2024: aquela le ZRoutedRpc.Everybody
         com ldsfld, e no Valheim 1.0 esse campo virou const. Ler um literal por ldsfld
         estoura MissingFieldException na primeira sincronizacao de config: quebra que
         nenhuma compilacao pega, so aparece com um cliente conectado. -->
    <Compile Include="ThirdParty\ConfigSync.cs" />
    <Compile Include="Hearthstone\Hearthstone.cs" />
    <Compile Include="Hearthstone\Patches.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Hearthstone\app.config" />
    <EmbeddedResource Include="Hearthstone\assets\hearthstone">
      <LogicalName>Hearthstone.assets.hearthstone</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Include="Hearthstone\ILRepack.targets" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task">
      <Version>2.0.44.1</Version>
    </PackageReference>
  </ItemGroup>
