    <OutputType>Library</OutputType>
    <AssemblyName>Hearthstone</AssemblyName>
    <ILRepackTargetsFile>$(ProjectDir)Hearthstone\ILRepack.targets</ILRepackTargetsFile>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <FileAlignment>512</FileAlignment>
    <!-- ConfigSync.cs vem verbatim do ServerSync e usa namespace de arquivo (C# 10). -->
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hearthstone</RootNamespace>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
